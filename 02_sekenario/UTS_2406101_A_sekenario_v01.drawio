                <mxCell id="WnsgHqOFqsz20Eys4YMR-35" parent="WnsgHqOFqsz20Eys4YMR-33" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;pointerEvents=1;" value="&lt;div&gt;&lt;span style=&quot;font-family: Arial; color: rgb(0, 0, 0); font-size: 11.04pt;&quot;&gt;&lt;font face=&quot;Arial&quot;&gt;Pemohon, yaitu Mahasiswa Baru dan Mahasiswa Lama, dapat melihat daftar &lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-family: Arial; color: rgb(0, 0, 0); font-size: 11.04pt;&quot;&gt;&lt;font face=&quot;Arial&quot;&gt;beasiswa beserta syarat dan batas akhir pendaftarannya, lalu mengajukan &lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-family: Arial; color: rgb(0, 0, 0); font-size: 11.04pt;&quot;&gt;&lt;font face=&quot;Arial&quot;&gt;beasiswa yang masih dibuka. Ada dua jenis bea&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;font-family: Arial; color: rgb(0, 0, 0); font-size: 11.04pt;&quot;&gt;&lt;font face=&quot;Arial&quot;&gt; &lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;font-family: Arial; color: rgb(0, 0, 0); font-size: 11.04pt;&quot;&gt;&lt;font face=&quot;Arial&quot;&gt;siswa dengan syarat berkas yang &lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-family: Arial; color: rgb(0, 0, 0); font-size: 11.04pt;&quot;&gt;&lt;font face=&quot;Arial&quot;&gt;berbeda: Beasiswa Prestasi mensyaratkan bukti prestasi, sedangkan Beasiswa &lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-family: Arial; color: rgb(0, 0, 0); font-size: 11.04pt;&quot;&gt;&lt;font face=&quot;Arial&quot;&gt;Kurang Mampu mensyaratkan surat keterangan tidak mampu. Selain itu, &lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-family: Arial; color: rgb(0, 0, 0); font-size: 11.04pt;&quot;&gt;&lt;font face=&quot;Arial&quot;&gt;Mahasiswa Baru melampirkan bukti kelulusan SMA, sedangkan Mahasiswa Lama &lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-family: Arial; color: rgb(0, 0, 0); font-size: 11.04pt;&quot;&gt;&lt;font face=&quot;Arial&quot;&gt;melampir&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;font-family: Arial; color: rgb(0, 0, 0); font-size: 11.04pt;&quot;&gt;&lt;font face=&quot;Arial&quot;&gt; &lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;font-family: Arial; color: rgb(0, 0, 0); font-size: 11.04pt;&quot;&gt;&lt;font face=&quot;Arial&quot;&gt;kan transkrip nilai. Sebelum pengajuan disimpan, sistem memeriksa &lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-family: Arial; color: rgb(0, 0, 0); font-size: 11.04pt;&quot;&gt;&lt;font face=&quot;Arial&quot;&gt;kelengkapan berkas yang diunggah pemohon. Pengajuan yang lengkap tercatat &lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-family: Arial; color: rgb(0, 0, 0); font-size: 11.04pt;&quot;&gt;&lt;font face=&quot;Arial&quot;&gt;dengan status Diajukan dan dapat dilacak statusnya oleh pemohon.&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;" vertex="1">
